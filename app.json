let dashboardData = null;
let chartInstance = null;

// Calculation formulas
function calcCash(val, t) {
  return val * 12 * t;
}

function calcSavings(val, t) {
  const r = dashboardData.rates.savings / 12;
  return val * ((Math.pow(1 + r, 12 * t) - 1) / r);
}

function calcBonds(val, t) {
  const r = dashboardData.rates.bonds / 12;
  return val * ((Math.pow(1 + r, 12 * t) - 1) / r);
}

function calcIndexFund(val, t) {
  // Sine wave models cyclical bull and bear markets around a ~7% net CAGR baseline
  const effectiveAnnual = dashboardData.rates.equity + 0.04 * Math.sin(t * 1.2);
  const r = effectiveAnnual / 12;
  return val * ((Math.pow(1 + r, 12 * t) - 1) / r);
}

function formatCurrency(num) {
  return dashboardData.currencySymbol + Math.round(num).toLocaleString();
}

function updateDashboard(monthlyAmount) {
  const years = Array.from({ length: 20 }, (_, i) => i + 1);

  const cashData = years.map(y => calcCash(monthlyAmount, y));
  const savingsData = years.map(y => calcSavings(monthlyAmount, y));
  const bondsData = years.map(y => calcBonds(monthlyAmount, y));
  const fundData = years.map(y => calcIndexFund(monthlyAmount, y));

  // Update Summary Cards
  document.getElementById('milestone-5').textContent = formatCurrency(calcIndexFund(monthlyAmount, 5));
  document.getElementById('milestone-10').textContent = formatCurrency(calcIndexFund(monthlyAmount, 10));
  document.getElementById('milestone-20').textContent = formatCurrency(calcIndexFund(monthlyAmount, 20));

  // Update Table
  const tbody = document.getElementById('table-body');
  tbody.innerHTML = '';
  dashboardData.timeframes.forEach(t => {
    const row = document.createElement('tr');
    row.innerHTML = `
      <td class="py-3 font-semibold text-slate-700">${t} ${t === 1 ? 'Year' : 'Years'}</td>
      <td class="py-3 text-slate-600">${formatCurrency(calcCash(monthlyAmount, t))}</td>
      <td class="py-3 text-blue-600">${formatCurrency(calcSavings(monthlyAmount, t))}</td>
      <td class="py-3 text-emerald-600">${formatCurrency(calcBonds(monthlyAmount, t))}</td>
      <td class="py-3 text-purple-600 font-bold">${formatCurrency(calcIndexFund(monthlyAmount, t))}</td>
    `;
    tbody.appendChild(row);
  });

  // Update Chart
  if (chartInstance) {
    chartInstance.data.datasets[0].data = cashData;
    chartInstance.data.datasets[1].data = savingsData;
    chartInstance.data.datasets[2].data = bondsData;
    chartInstance.data.datasets[3].data = fundData;
    chartInstance.update();
  } else {
    const ctx = document.getElementById('projectionChart').getContext('2d');
    chartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: years.map(y => `Yr ${y}`),
        datasets: [
          { label: 'Total Cash Deposited', data: cashData, borderColor: '#94a3b8', tension: 0.1 },
          { label: 'Savings Account (2.5%)', data: savingsData, borderColor: '#3b82f6', tension: 0.1 },
          { label: 'Fixed Deposit / Bonds (4.0%)', data: bondsData, borderColor: '#10b981', tension: 0.1 },
          { label: 'Vanguard / Market (~7.0% Net)', data: fundData, borderColor: '#8b5cf6', tension: 0.3 }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        scales: {
          y: {
            ticks: {
              callback: (value) => dashboardData.currencySymbol + value.toLocaleString()
            }
          }
        }
      }
    });
  }
}

// Fetch JSON settings and bind inputs
async function init() {
  try {
    const response = await fetch('config.json');
    dashboardData = await response.json();
  } catch (e) {
    // Fallback if running directly without a local server
    dashboardData = {
      currencySymbol: "£",
      timeframes: [1, 3, 5, 10, 15, 20],
      rates: { savings: 0.025, bonds: 0.040, equity: 0.070 }
    };
  }

  const inputEl = document.getElementById('monthly-input');
  const sliderEl = document.getElementById('monthly-slider');

  inputEl.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value) || 0;
    sliderEl.value = val;
    updateDashboard(val);
  });

  sliderEl.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value) || 0;
    inputEl.value = val;
    updateDashboard(val);
  });

  updateDashboard(500);
}

document.addEventListener('DOMContentLoaded', init);
